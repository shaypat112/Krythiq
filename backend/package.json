{
  "name": "krythiq",
  "version": "0.2.0",
  "description": "CLI for Semgrep/npm-audit security scans, custom rules, and optional AI terminal trace analysis",
  "keywords": [
    "cli",
    "ai",
    "debugging",
    "security",
    "stack-trace",
    "devtools",
    "semgrep",
    "npm-audit"
  ],
  "author": "Krythiq",
  "homepage": "https://krythiq.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaypat112/Krythiq.git"
  },
  "bugs": {
    "url": "https://github.com/shaypat112/Krythiq/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "krythiq": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "conf": "^13.1.0",
    "glob": "^13.0.6",
    "inquirer": "^14.0.2",
    "ora": "^8.0.1",
    "strip-ansi": "^7.1.0",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/update-notifier": "^6.0.8",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "esbuild": "^0.28.1"
  }
}
