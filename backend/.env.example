# Optional: enables Anthropic terminal trace analysis for `krythiq run`.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
KRYTHIQ_TRACE_MODEL=claude-sonnet-4-5

# KRYTHIQ_MODEL is a lower-priority trace-model alias.

# Optional: enables a Mistral summary when `krythiq scan --ai` is used.
MISTRAL_API_KEY=
KRYTHIQ_SCAN_AI_MODEL=mistral-small-latest
KRYTHIQ_SCAN_AI=false

# Optional: all three are required together for `krythiq scan --publish`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_ACCESS_TOKEN=
KRYTHIQ_PUBLISH=false

# Optional: disables the interactive npm version check.
NO_UPDATE_NOTIFIER=1
