{
  "$schema": "https://unpkg.com/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs",
        "tests/**/*.mjs",
        "app/**/*.test.mjs",
        "krythiq.config.mjs"
      ],
      "ignoreDependencies": [
        "krythiq",
        "fast-glob"
      ],
      "ignore": [
        "app/.agents/**"
      ]
    },
    "tools/eslint-glob": {
      "project": ["**/*.mjs"]
    },
    "backend": {
      "entry": [
        "src/index.ts",
        "test/**/*.test.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.mjs"
      ]
    }
  }
}
