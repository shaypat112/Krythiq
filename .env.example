# Public application configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
# Legacy fallback only. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase access used by account deletion and team administration
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Scanning and AI
GITHUB_TOKEN=github_pat_optional_for_public_scan_rate_limits
MISTRAL_API_KEY=your-mistral-key
MISTRAL_MODEL=mistral-large-latest

# Billing
STRIPE_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_PRICE_PRO=price_xxxxx
STRIPE_PRICE_TEAM=price_xxxxx
STRIPE_PRICE_TOKENS_250=price_xxxxx
STRIPE_PRICE_TOKENS_750=price_xxxxx
STRIPE_PRICE_TOKENS_2000=price_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Email
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=Krythiq <notifications@krythiq.dev>
RESEND_REPLY_TO=support@krythiq.dev
NOTIFICATION_EMAIL_WEBHOOK_URL=https://example.com/webhooks/notifications
NOTIFICATION_EMAIL_WEBHOOK_TOKEN=optional-webhook-token

# Recommended server-only HMAC secret for referral email hashes and opt-out links.
# Generate at least 32 random bytes, for example: openssl rand -base64 48
# When omitted, the server derives a domain-separated key from SUPABASE_SERVICE_ROLE_KEY.
REFERRAL_SIGNING_SECRET=replace-with-a-long-random-secret

# Platform administrator identity; leave all blank to disable admin access
ADMIN_PROFILE_USERNAME=
ADMIN_FULL_NAME=
ADMIN_GITHUB_LOGIN=
