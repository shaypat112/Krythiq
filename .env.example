# Public application configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback only. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase access used by account deletion and team administration
SUPABASE_SERVICE_ROLE_KEY=

# Scanning and AI
GITHUB_TOKEN=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Frontend AI review via Groq (server-only; never prefix these with NEXT_PUBLIC_)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional xAI fallback
XAI_API_KEY=
GROK_MODEL=grok-3-mini

# Billing — test mode only. Live-mode keys are rejected.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_YEARLY=
TOKEN_ADMIN_GITHUB_LOGIN=
STRIPE_PRICE_TOKENS_250=
STRIPE_PRICE_TOKENS_750=
STRIPE_PRICE_TOKENS_2000=
STRIPE_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.com
RESEND_REPLY_TO=
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_EMAIL_WEBHOOK_TOKEN=

# Recommended server-only HMAC secret for referral email hashes and opt-out links.
# Generate at least 32 random bytes, for example: openssl rand -base64 48
# When omitted, the server derives a domain-separated key from SUPABASE_SERVICE_ROLE_KEY.
REFERRAL_SIGNING_SECRET=

# Platform administrator identity; leave all blank to disable admin access
ADMIN_PROFILE_USERNAME=
ADMIN_FULL_NAME=
ADMIN_GITHUB_LOGIN=
