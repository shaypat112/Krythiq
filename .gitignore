# Supabase migrations are source code and are safe to publish. Ignore only
# local CLI state, credentials, branch metadata, and machine-specific seeds.
/supabase/.temp/
/supabase/.branches/
/supabase/.env
/supabase/.env.*
/supabase/config.local.toml
/supabase/seed.local.sql
/supabase/*.dump
/supabase/*.backup

# local editor and AI-assistant instructions
/.idea/
/.vscode/settings.local.json
/.agents/
/.codex/
/.claude/
/.cursor/
/AGENTS.md
/CLAUDE.md
/UNUSED.md

# local deployment and provider state
